   </attribute>
   <addaction name="actionUndo"/>
   <addaction name="actionCuT"/>
   <addaction name="actionCopy"/>
   <addaction name="actionPaste"/>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
  <action name="actionNew">
   <property name="icon">
    <iconset resource="images/designwindow.qrc"><normaloff>:/images/new.png</normaloff>:/images/new.png</iconset>
   </property>
   <property name="text"><string>新增(&amp;N)</string></property>
   <property name="toolTip"><string>新增(清空工作區)</string></property>
   <property name="shortcut"><string>Ctrl+N</string></property>
  </action>
  <action name="actionOpen">
   <property name="icon">
    <iconset resource="images/designwindow.qrc"><normaloff>:/images/open.png</normaloff>:/images/open.png</iconset>
   </property>
   <property name="text"><string>開啟(&amp;O)</string></property>
   <property name="toolTip"><string>開啟圖片</string></property>
   <property name="shortcut"><string>Ctrl+O</string></property>
  </action>
  <action name="actionClose">
   <property name="text"><string>關閉(&amp;C)</string></property>
   <property name="toolTip"><string>關閉目前圖片</string></property>
  </action>
  <action name="actionSave">
   <property name="icon">
    <iconset resource="images/designwindow.qrc"><normaloff>:/images/save.png</normaloff>:/images/save.png</iconset>
