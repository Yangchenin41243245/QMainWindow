   </property>
   <property name="text"><string>剪下(&amp;T)</string></property>
   <property name="toolTip"><string>剪下圖片到剪貼簿</string></property>
   <property name="shortcut"><string>Ctrl+X</string></property>
  </action>
  <action name="actionAll">
   <property name="text"><string>全選(&amp;A)</string></property>
