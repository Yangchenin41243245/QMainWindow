   <property name="text"><string>還原(&amp;U)</string></property>
   <property name="toolTip"><string>還原上一步</string></property>
   <property name="shortcut"><string>Ctrl+Z</string></property>
  </action>
  <action name="actionCuT">
   <property name="icon">
